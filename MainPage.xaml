<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PayLink.MainPage"
             BackgroundColor="#F5F7FA">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

        <!-- Titre -->
        <Label Text="PAYLINK" 
               TextColor="#0A2540" 
               FontSize="32" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" 
               Margin="0,0,0,40"/>

        <!-- Champ Email -->
        <Border Stroke="#D1D5DB" StrokeThickness="1" BackgroundColor="White" Padding="15,0" HeightRequest="50">
            <Entry Placeholder="Email ou Téléphone" TextColor="#1A1A1A" PlaceholderColor="#6B7280"/>
        </Border>

        <!-- Champ Mot de passe (en état d'erreur) -->
        <Border Stroke="#EF4444" StrokeThickness="2" BackgroundColor="White" Padding="15,0" HeightRequest="50">
            <Entry Placeholder="Mot de passe" IsPassword="True" TextColor="#1A1A1A" PlaceholderColor="#6B7280"/>
        </Border>

        <!-- Message d'erreur -->
        <Label Text="Mot de passe incorrect" TextColor="#EF4444" FontSize="12" Margin="0,-15,0,0"/>

        <!-- Bouton Se connecter -->
        <Button Text="Se connecter" 
                BackgroundColor="#00A86B" 
                TextColor="White" 
                FontAttributes="Bold"
                CornerRadius="12"
                HeightRequest="50"
                Margin="0,20,0,0"/>
        clicked="OnSeConnecterClicked"/>

        <!-- Liens -->
        <Label Text="Mot de passe oublié ?" TextColor="#0A2540" FontSize="12" HorizontalOptions="Center"/>

        <!-- Lien Créer un compte (Cliquable) -->
        <Label Text="Créer un compte" TextColor="#0A2540" FontSize="12" HorizontalOptions="Center">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCreerCompteTapped" />
            </Label.GestureRecognizers>
        </Label>

    </VerticalStackLayout>

</ContentPage>