<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PayLink.HistoriquePage"
             BackgroundColor="#F5F7FA">

    <Grid RowDefinitions="Auto, *">

        <!-- EN-TÊTE ET RECHERCHE -->
        <VerticalStackLayout Grid.Row="0" Padding="20,20,20,10" Spacing="15">
            <Label Text="Historique" 
                   TextColor="#1A1A1A" 
                   FontSize="24" 
                   FontAttributes="Bold"/>

            <!-- Barre de recherche -->
            <Border Stroke="#D1D5DB" StrokeThickness="1" BackgroundColor="White" Padding="10,0" HeightRequest="40">
                <Grid ColumnDefinitions="Auto, *">
                    <Label Text="🔍" VerticalOptions="Center" Margin="0,0,10,0"/>
                    <Entry Grid.Column="1" Placeholder="Rechercher une transaction..." PlaceholderColor="#6B7280" TextColor="#1A1A1A"/>
                </Grid>
            </Border>

            <!-- Filtres -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                <Button Text="Date" BackgroundColor="White" BorderColor="#D1D5DB" BorderWidth="1" TextColor="#6B7280" CornerRadius="8" HeightRequest="35" FontSize="12"/>
                <Button Grid.Column="1" Text="Opérateur" BackgroundColor="White" BorderColor="#D1D5DB" BorderWidth="1" TextColor="#6B7280" CornerRadius="8" HeightRequest="35" FontSize="12"/>
            </Grid>
        </VerticalStackLayout>

        <!-- LISTE DES TRANSACTIONS -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,0,20,20" Spacing="10">

                <!-- Transaction 1 (Cliquable) -->
                <Border StrokeShape="RoundRectangle 12" BackgroundColor="White" Padding="15" StrokeThickness="0">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTransactionTapped" />
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">
                        <Border StrokeShape="RoundRectangle 20" BackgroundColor="#FF7900" WidthRequest="40" HeightRequest="40"/>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Dépôt Orange" TextColor="#1A1A1A" FontAttributes="Bold" FontSize="14"/>
                            <Label Text="12 Octobre 2026" TextColor="#6B7280" FontSize="12"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="+ 10 000 FCFA" TextColor="#00A86B" FontAttributes="Bold" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Transaction 2 -->
                <Border StrokeShape="RoundRectangle 12" BackgroundColor="White" Padding="15" StrokeThickness="0">
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">
                        <Border StrokeShape="RoundRectangle 20" BackgroundColor="#FFCC00" WidthRequest="40" HeightRequest="40"/>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Retrait MTN" TextColor="#1A1A1A" FontAttributes="Bold" FontSize="14"/>
                            <Label Text="11 Octobre 2026" TextColor="#6B7280" FontSize="12"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="- 5 000 FCFA" TextColor="#EF4444" FontAttributes="Bold" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Transaction 3 -->
                <Border StrokeShape="RoundRectangle 12" BackgroundColor="White" Padding="15" StrokeThickness="0">
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">
                        <Border StrokeShape="RoundRectangle 20" BackgroundColor="#FF7900" WidthRequest="40" HeightRequest="40"/>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Dépôt Orange" TextColor="#1A1A1A" FontAttributes="Bold" FontSize="14"/>
                            <Label Text="10 Octobre 2026" TextColor="#6B7280" FontSize="12"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="+ 25 000 FCFA" TextColor="#00A86B" FontAttributes="Bold" VerticalOptions="Center"/>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
    