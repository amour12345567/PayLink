<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PayLink.ComptesPage"
             BackgroundColor="#F5F7FA">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Titre -->
            <Label Text="Mes Comptes" 
                   TextColor="#1A1A1A" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   Margin="0,10,0,5"/>

            <Label Text="Gérez vos comptes Mobile Money" 
                   TextColor="#6B7280" 
                   FontSize="14" 
                   Margin="0,0,0,15"/>

            <!-- Carte MTN MoMo -->
            <Border StrokeShape="RoundRectangle 12" BackgroundColor="White" Padding="15" StrokeThickness="0">
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">
                    <Border StrokeShape="RoundRectangle 25" BackgroundColor="#FFCC00" WidthRequest="45" HeightRequest="45">
                        <Label Text="MTN" TextColor="Black" FontAttributes="Bold" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="MTN MoMo" TextColor="#1A1A1A" FontAttributes="Bold" FontSize="16"/>
                        <Label Text="Compte principal" TextColor="#6B7280" FontSize="12"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="50 000 FCFA" TextColor="#00A86B" FontAttributes="Bold" FontSize="16" VerticalOptions="Center"/>
                </Grid>
            </Border>

            <!-- Carte Orange Money -->
            <Border StrokeShape="RoundRectangle 12" BackgroundColor="White" Padding="15" StrokeThickness="0">
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">
                    <Border StrokeShape="RoundRectangle 25" BackgroundColor="#FF7900" WidthRequest="45" HeightRequest="45">
                        <Label Text="OM" TextColor="White" FontAttributes="Bold" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="Orange Money" TextColor="#1A1A1A" FontAttributes="Bold" FontSize="16"/>
                        <Label Text="Compte secondaire" TextColor="#6B7280" FontSize="12"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="100 000 FCFA" TextColor="#00A86B" FontAttributes="Bold" FontSize="16" VerticalOptions="Center"/>
                </Grid>
            </Border>

            <!-- Bouton Ajouter un compte (Style pointillés) -->
            <Border StrokeShape="RoundRectangle 12" BackgroundColor="Transparent" Stroke="#6B7280" StrokeThickness="2" StrokeDashArray="5,5" Padding="15" Margin="0,10,0,0" HeightRequest="60">
                <Label Text="+ Ajouter un compte" 
                       TextColor="#0A2540" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center"/>
            </Border>

            <!-- Total Consolidé -->
            <Border StrokeShape="RoundRectangle 8" BackgroundColor="#E6F0FF" Padding="15" Margin="0,20,0,0" StrokeThickness="0">
                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="Total consolidé" TextColor="#0A2540" VerticalOptions="Center" FontAttributes="Bold" FontSize="14"/>
                    <Label Grid.Column="1" Text="150 000 FCFA" TextColor="#0A2540" FontAttributes="Bold" VerticalOptions="Center" FontSize="18"/>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>