<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PayLink.InscriptionPage"
             BackgroundColor="#F5F7FA">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="15">

            <!-- Titre -->
            <Label Text="Créer un compte" 
                   TextColor="#0A2540" 
                   FontSize="28" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   Margin="0,20,0,20"/>

            <!-- Champ Nom -->
            <Border Stroke="#D1D5DB" StrokeThickness="1" BackgroundColor="White" Padding="15,0" HeightRequest="50">
                <Entry Placeholder="Nom complet" TextColor="#1A1A1A" PlaceholderColor="#6B7280"/>
            </Border>

            <!-- Champ Email -->
            <Border Stroke="#D1D5DB" StrokeThickness="1" BackgroundColor="White" Padding="15,0" HeightRequest="50">
                <Entry Placeholder="Email" Keyboard="Email" TextColor="#1A1A1A" PlaceholderColor="#6B7280"/>
            </Border>

            <!-- Champ Téléphone -->
            <Border Stroke="#D1D5DB" StrokeThickness="1" BackgroundColor="White" Padding="15,0" HeightRequest="50">
                <Entry Placeholder="Téléphone" Keyboard="Telephone" TextColor="#1A1A1A" PlaceholderColor="#6B7280"/>
            </Border>

            <!-- Champ Mot de passe -->
            <Border Stroke="#D1D5DB" StrokeThickness="1" BackgroundColor="White" Padding="15,0" HeightRequest="50">
                <Entry Placeholder="Mot de passe" IsPassword="True" TextColor="#1A1A1A" PlaceholderColor="#6B7280"/>
            </Border>

            <!-- Champ Confirmer Mot de passe -->
            <Border Stroke="#D1D5DB" StrokeThickness="1" BackgroundColor="White" Padding="15,0" HeightRequest="50">
                <Entry Placeholder="Confirmer le mot de passe" IsPassword="True" TextColor="#1A1A1A" PlaceholderColor="#6B7280"/>
            </Border>

            <!-- Case à cocher -->
            <HorizontalStackLayout Spacing="10" Margin="0,10,0,0">
                <CheckBox Color="#0A2540" />
                <Label Text="J'accepte les conditions d'utilisation" 
                       TextColor="#6B7280" 
                       VerticalOptions="Center" 
                       FontSize="12"/>
            </HorizontalStackLayout>

            <!-- Bouton S'inscrire (État désactivé : gris) -->
            <Button Text="S'inscrire" 
                    BackgroundColor="#D1D5DB" 
                    TextColor="White" 
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="50"
                    Margin="0,20,0,0"/>

            <!-- Lien de retour -->
            <Label Text="Déjà un compte ? Se connecter" 
                   TextColor="#0A2540" 
                   FontSize="12" 
                   HorizontalOptions="Center" 
                   Margin="0,10,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>