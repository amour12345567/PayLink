<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PayLink.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PayLink"
    Title="PayLink">

        <!-- Écran de départ (sans barre de navigation) -->
        <ShellContent
        Title="Connexion"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

        <!-- Écran d'inscription (sans barre de navigation) -->
        <ShellContent
        Title="Inscription"
        ContentTemplate="{DataTemplate local:InscriptionPage}"
        Route="InscriptionPage" />

        <!-- LE MENU PRINCIPAL AVEC LA BARRE EN BAS (TabBar) -->
        <TabBar>
            <ShellContent Title="Dashboard" ContentTemplate="{DataTemplate local:DashboardPage}" Route="DashboardPage" />
            <ShellContent Title="Historique" ContentTemplate="{DataTemplate local:HistoriquePage}" Route="HistoriquePage" />
            <ShellContent Title="Comptes" ContentTemplate="{DataTemplate local:ComptesPage}" Route="ComptesPage" />
            <ShellContent Title="Profil" ContentTemplate="{DataTemplate local:ProfilPage}" Route="ProfilPage" />
        </TabBar>

        <!-- Pages qui n'ont pas besoin d'être dans la barre en bas mais qu'on doit pouvoir atteindre -->
        <ShellContent Title="Ajout" ContentTemplate="{DataTemplate local:AjoutTransactionPage}" Route="AjoutTransactionPage" />
        <ShellContent Title="Détails" ContentTemplate="{DataTemplate local:DetailsTransactionPage}" Route="DetailsTransactionPage" />

    </Shell>
