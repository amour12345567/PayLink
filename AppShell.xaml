<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PayLink.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PayLink"
    Title="PayLink">

    <ShellContent
    Title="Connexion"
    ContentTemplate="{DataTemplate local:MainPage}"
    Route="MainPage" />
    
    <ShellContent
        Title="Inscription"
        ContentTemplate="{DataTemplate local:InscriptionPage}"
        Route="InscriptionPage" />

    <ShellContent
    Title="Dashboard"
    ContentTemplate="{DataTemplate local:DashboardPage}"
    Route="DashboardPage" />

    <ShellContent
Title="Ajout"
ContentTemplate="{DataTemplate local:AjouterTransactionPage}"
Route="AjouterTransactionPage" />

    <ShellContent
Title="Historique"
ContentTemplate="{DataTemplate local:HistoriquePage}"
Route="HistoriquePage" />

    <ShellContent
Title="Comptes"
ContentTemplate="{DataTemplate local:ComptesPage}"
Route="ComptesPage" />

    <ShellContent
Title="Details"
ContentTemplate="{DataTemplate local:DetailsTransactionPage}"
Route="DetailsTransactionPage" />

    <ShellContent
Title="Profil"
ContentTemplate="{DataTemplate local:ProfilPage}"
Route="ProfilPage" />

</Shell>
